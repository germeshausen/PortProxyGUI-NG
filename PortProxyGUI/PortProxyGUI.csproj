<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>PPGUI</AssemblyName>
    <RootNamespace>PortProxyGUI</RootNamespace>
    <Version>2.0.0</Version>
    <Product>PortProxyGUI NG</Product>
    <AssemblyTitle>PortProxyGUI NG</AssemblyTitle>
    <Authors>zmjack;germeshausen</Authors>
    <Company>germeshausen</Company>
    <Description>A .NET 10 Windows port proxy manager, based on PortProxyGUI by zmjack and extended by germeshausen.</Description>
    <RepositoryUrl>https://github.com/germeshausen/PortProxyGUI-NG</RepositoryUrl>
    <PackageProjectUrl>https://github.com/germeshausen/PortProxyGUI-NG</PackageProjectUrl>
    <Copyright>Original work Copyright (c) 2019 zmjack. Fork modifications Copyright (c) 2026 germeshausen.</Copyright>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
</Project>
